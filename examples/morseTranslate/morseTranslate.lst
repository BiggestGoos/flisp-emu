File: morseTranslate.lst
FC                      1. Inport: EQU $FC
---- File: "morseTranslate.sflisp"
FB                      2. Utport: EQU $FB
03                      3. DelayC1: EQU $3 ;Dessa konstanter styr hur lång fördröjning Delay1s orsakar.
01                      4. DelayC2: EQU $1 ;Ändra dem eventuellt i labbet så att fördröjnigen blir rimligt lång.
                        5. 
FB                      6.   ORG Utport
FB 00                   7.   FCB $0
                        8. 
FF                      9.   ORG  $FF
FF 20                  10.   FCB  $20
                       11. 
20                     12.   ORG  $20
                       13. 
20 90 7F               14.   LDX #MorseCode
22 92 20               15.   LDSP #$20
24                     16. Main:
                       17. 
24 20 13               18.   BSR ReadAscii
26 20 17               19.   BSR FromAscii
                       20. 
28 0B                  21.   ASLA
29 10                  22.   PSHA
                       23. 
2A F4                  24.   LDA A,X
2B E1 7E               25.   STA Count
                       26. 
2D 14                  27.   PULA
2E 07                  28.   INCA
                       29. 
2F F4                  30.   LDA A,X
                       31. 
30                     32. Main_loop:
30 20 1E               33.   BSR BlinkLight
32 0B                  34.   LSLA
33 38 7E               35.   DEC Count
35 25 F9               36.   BNE Main_loop
                       37. 
37 21 EB               38.   BRA  Main
                       39. 
39                     40. ReadAscii:
                       41. 
39                     42. ReadAscii_loop:
39 F1 FC               43.   LDA Inport
                       44. 
3B 0C                  45.   LSRA
                       46. 
3C 29 FB               47.   BCC ReadAscii_loop
3E 43                  48.   RTS
                       49. 
3F                     50. FromAscii: ; Ascii code in A, LSB of code is LSB of A
3F 94 41               51.   SUBA #'A'
                       52. 
41 22 06               53.   BMI FromAscii_error ; Input was too low
43 97 5A               54.   CMPA #'Z'
45 2A 02               55.   BHI FromAscii_error ; Input was too high
                       56. 
47 21 06               57.   BRA FromAscii_end
                       58. 
49                     59. FromAscii_error: ; If an incorrect input
49 F0 FF               60.   LDA #$FF
4B E1 FB               61.   STA Utport
4D 21 FA               62.   BRA FromAscii_error
4F                     63. FromAscii_end:
4F 43                  64.   RTS
                       65. 
50                     66. BlinkLight:
50 10                  67.   PSHA
                       68. 
51 F0 FF               69.   LDA #$FF
53 E1 FB               70.   STA Utport
55 F2 00               71.   LDA 0,SP
                       72. 
57 0B                  73.   LSLA
58 29 06               74.   BCC BlinkLight_short
                       75. 
5A 20 0E               76.   BSR Delay1s
5C 20 0C               77.   BSR Delay1s
5E 20 0A               78.   BSR Delay1s
60                     79. BlinkLight_short:
60 20 08               80.   BSR Delay1s
                       81. 
62 F0 00               82.   LDA #$0
64 E1 FB               83.   STA Utport
66 20 02               84.   BSR Delay1s
                       85. 
68 14                  86.   PULA
69 43                  87.   RTS
                       88. 
                       89. ; Orsakar en fördröjning på ungefär 1s i simulatorn (vid snabb exekveringshastighet)
                       90. ; Ändrar inga register
6A                     91. Delay1s:
6A 10                  92.   PSHA
6B 11                  93.   PSHX
6C 13                  94.   PSHC
6D 90 01               95.   LDX  #DelayC2
6F                     96. Delay1s_loop2:
6F F0 03               97.   LDA  #DelayC1
71                     98. Delay1s_loop:
71 08                  99.   DECA
72 25 FD              100.   BNE  Delay1s_loop
74 CC FF              101.   LEAX  -1,X
76 9C 00              102.   CMPX  #0
78 25 F5              103.   BNE  Delay1s_loop2
7A 17                 104.   PULC
7B 15                 105.   PULX
7C 14                 106.   PULA
7D 43                 107.   RTS
