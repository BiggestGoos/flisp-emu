3F                     58. FromAscii: ; Ascii code in A, LSB of code is LSB of A
3F 94 41               59.   SUBA #'A'
                       60. 
41 22 06               61.   BMI FromAscii_error ; Input was too low
43 97 5A               62.   CMPA #'Z'
45 2A 02               63.   BHI FromAscii_error ; Input was too high
                       64. 
47 21 06               65.   BRA FromAscii_end
                       66. 
49                     67. FromAscii_error: ; If an incorrect input
49 F0 FF               68.   LDA #$FF
4B E1 FB               69.   STA Utport
4D 21 FA               70.   BRA FromAscii_error
4F                     71. FromAscii_end:
4F 43                  72.   RTS
                       73. 
