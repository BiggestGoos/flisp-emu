44                     56. FromAscii: ; Ascii code in A, LSB of code is LSB of A
44 94 41               57.   SUBA #'A'
                       58. 
46 22 06               59.   BMI FromAscii_error ; Input was too low
48 97 1A               60.   CMPA #26
4A 29 02               61.   BCC FromAscii_error ; Input was too high
                       62. 
4C 21 06               63.   BRA FromAscii_end
                       64. 
4E                     65. FromAscii_error: ; If an incorrect input
4E F0 FF               66.   LDA #$FF
50 E1 FB               67.   STA Utport
52                     68. FromAscii_error_loop:
52 21 FE               69.   BRA FromAscii_error_loop
54                     70. FromAscii_end:
54 43                  71.   RTS
                       72. 
