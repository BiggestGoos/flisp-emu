                        2. 
05 B3                   3. val: FCB %10110011
06 00                   4. res: RMB 1
                        5. 
20                      6. start: EQU $20
                        7. 
20                      8.   ORG start
20 92 20                9.   LDSP #start
                       10. 
22 90 05               11.   LDX #val
                       12. 
24 20 0A               13.   BSR REV8
                       14. 
26 E1 06               15.   STA res
                       16. 
28 33 44               17.   JMP end
                       18. 
30                     19.   ORG $30
30                     20. REV8:
                       21. 
30 F3 00               22.   LDA 0,X ; A = input
32 10                  23.   PSHA    ; Store input
                       24. 
33 F0 08               25.   LDA #8  ; # of iterations, bits
35 10                  26.   PSHA
                       27. 
36 05                  28.   CLRA
37 10                  29.   PSHA    ; Result (starts at 0)
                       30. 
38                     31. REV8_loop:
                       32. 
38                     33.   ; Get the rightmost bit
38 4C 02               34.   LSR 2,SP
                       35. 
3A                     36.   ; Push that bit to the left
3A 4D 00               37.   ROL 0,SP
                       38. 
3C 48 01               39.   DEC 1,SP
3E 25 F8               40.   BNE REV8_loop
                       41. 
40 14                  42.   PULA
                       43. 
41 BE 02               44.   LEASP 2,SP
43 43                  45.   RTS
                       46. 
44                     47. end:
                       48. 
FF                     49.   ORG $FF
